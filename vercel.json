{
  "cleanUrls": false,
  "rewrites": [{ "source": "/((?!images/|.*\\.(?:js|css|png|jpg|jpeg|webp|svg|ico|txt|xml|json)$).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
